{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 10
  },
  "configurePresets": [
    {
      "name": "windows-vs2022",
      "displayName": "Windows x64 / VS2022 v143",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64,version=10.0.26100.0",
      "toolset": "v143",
      "binaryDir": "${sourceDir}/out/build/windows-vs2022",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo",
        "BUILD_TESTING": "ON",
        "TINYME_BUILD_EDITOR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug"
    },
    {
      "name": "windows-profile",
      "configurePreset": "windows-vs2022",
      "configuration": "RelWithDebInfo"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "GPU" } },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "windows-profile",
      "configurePreset": "windows-vs2022",
      "configuration": "RelWithDebInfo",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "GPU" } },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
