if(NOT DEFINED PROGRAM)
    message(FATAL_ERROR "PROGRAM is required.")
endif()
get_filename_component(app_name "${PROGRAM}" NAME_WE)
get_filename_component(bin "${PROGRAM}" DIRECTORY)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(scratch "${bin}/profile-cli-${suffix}")
file(MAKE_DIRECTORY "${scratch}")
set(report "${scratch}/参数报告.json")
execute_process(COMMAND "${PROGRAM}" --windowed --profile --warmup 2 --samples 3
    --scale 0.5 --tint 1 0.5 0.25 1 --camera-eye 0.25 0.125 -3
    --camera-target 0.25 0.125 0 --fov 75 --gpu-validation --report "${report}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT "${code}" STREQUAL "0" OR NOT error STREQUAL "" OR NOT EXISTS "${report}"
        OR NOT output MATCHES "profile samples=3 warmup=2 requested=3 complete=1 environment_changed=0 dropped=0"
        OR NOT output MATCHES "presented_frames=5 closed_by_user=0 validation_warnings=0")
    message(FATAL_ERROR "Profile CLI failed: ${code}\n${output}\n${error}")
endif()
file(READ "${report}" json)
foreach(field IN ITEMS complete debug_layer gpu_validation vsync)
    string(JSON value GET "${json}" "${field}")
    if(NOT value)
        message(FATAL_ERROR "Expected true ${field}: ${json}")
    endif()
endforeach()
foreach(field IN ITEMS environment_changed closed_by_user dropped_samples validation_warnings)
    string(JSON value GET "${json}" "${field}")
    if(value)
        message(FATAL_ERROR "Unexpected integrity flag ${field}: ${json}")
    endif()
endforeach()
string(JSON adapter GET "${json}" adapter)
string(JSON count GET "${json}" sample_count)
string(JSON requested GET "${json}" requested_samples)
string(JSON warmup GET "${json}" warmup_frames)
string(JSON scale GET "${json}" scale)
string(JSON tint GET "${json}" tint 2)
string(JSON bytes GET "${json}" parameter_bytes)
string(JSON frequency GET "${json}" timestamp_frequency_hz)
if(NOT adapter STREQUAL "NVIDIA GeForce RTX 5080" OR NOT count EQUAL 3 OR NOT requested EQUAL 3
        OR NOT warmup EQUAL 2 OR NOT scale EQUAL 0.5 OR NOT tint EQUAL 0.25
        OR NOT bytes EQUAL 32 OR NOT frequency GREATER 0)
    message(FATAL_ERROR "Incorrect report metadata: ${json}")
endif()
string(JSON vertices GET "${json}" geometry vertex_count)
string(JSON indices GET "${json}" geometry index_count)
string(JSON stride GET "${json}" geometry vertex_stride)
string(JSON index_format GET "${json}" geometry index_format)
string(JSON upload_fence GET "${json}" geometry upload_fence)
string(JSON last_use_fence GET "${json}" geometry last_use_fence)
string(JSON matrix_bytes GET "${json}" camera matrix_bytes)
string(JSON matrix_count LENGTH "${json}" camera world_to_clip)
string(JSON eye_x GET "${json}" camera eye 0)
string(JSON eye_z GET "${json}" camera eye 2)
string(JSON target_y GET "${json}" camera target 1)
string(JSON fov GET "${json}" camera vertical_fov_degrees)
if(NOT vertices EQUAL 4 OR NOT indices EQUAL 3 OR NOT stride EQUAL 24
        OR NOT index_format STREQUAL "R16_UINT" OR NOT upload_fence GREATER 0
        OR NOT last_use_fence GREATER upload_fence OR NOT matrix_bytes EQUAL 64
        OR NOT matrix_count EQUAL 16 OR NOT eye_x EQUAL 0.25 OR NOT eye_z EQUAL -3
        OR NOT target_y EQUAL 0.125 OR NOT fov EQUAL 75)
    message(FATAL_ERROR "Incorrect indexed camera metadata: ${json}")
endif()
foreach(metric IN ITEMS cpu_record gpu_pass)
    string(JSON count GET "${json}" "${metric}" count)
    if(NOT count EQUAL 3)
        message(FATAL_ERROR "Incorrect ${metric} count")
    endif()
    foreach(stat IN ITEMS mean_ms median_ms p95_ms min_ms max_ms)
        string(JSON value GET "${json}" "${metric}" "${stat}")
        if(NOT value GREATER_EQUAL 0)
            message(FATAL_ERROR "Invalid ${metric}/${stat}")
        endif()
    endforeach()
endforeach()
foreach(index RANGE 0 2)
    math(EXPR expected "${index} + 3")
    string(JSON presentation GET "${json}" samples "${index}" presentation)
    if(NOT presentation EQUAL expected)
        message(FATAL_ERROR "Warmup/tail sample incorrectly assigned: ${json}")
    endif()
endforeach()
execute_process(COMMAND "${PROGRAM}" --windowed --profile --warmup 0 --samples 1 --report "${report}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 10)
file(READ "${report}" unchanged)
if(NOT "${code}" STREQUAL "1" OR NOT output STREQUAL "" OR NOT unchanged STREQUAL json
        OR NOT error MATCHES "new output path")
    message(FATAL_ERROR "Existing report must fail before GPU and remain unchanged: ${code}\n${output}\n${error}")
endif()
execute_process(COMMAND "${PROGRAM}" --windowed --experiment clear --profile --warmup 0 --samples 1
    --gpu-validation
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT "${code}" STREQUAL "0" OR NOT error STREQUAL "")
    message(FATAL_ERROR "Single-frame clear profile failed: ${code}\n${output}\n${error}")
endif()
string(FIND "${output}" "{\n  \"schema\"" start)
if(start LESS 0)
    message(FATAL_ERROR "No JSON report on stdout: ${output}")
endif()
string(SUBSTRING "${output}" ${start} -1 clear_json)
string(JSON count GET "${clear_json}" sample_count)
string(JSON generation GET "${clear_json}" pipeline_generation)
string(JSON complete GET "${clear_json}" complete)
string(JSON presentation GET "${clear_json}" samples 0 presentation)
string(JSON compiler_type TYPE "${clear_json}" compiler)
string(JSON applied GET "${clear_json}" parameters_applied)
string(JSON geometry_type TYPE "${clear_json}" geometry)
string(JSON camera_type TYPE "${clear_json}" camera)
if(NOT compiler_type STREQUAL "NULL" OR NOT geometry_type STREQUAL "NULL"
        OR NOT camera_type STREQUAL "NULL" OR applied)
    message(FATAL_ERROR "Clear must not claim to use DXC or triangle parameters: ${clear_json}")
endif()
if(NOT count EQUAL 1 OR NOT generation EQUAL 0 OR NOT complete OR NOT presentation EQUAL 1)
    message(FATAL_ERROR "Single-frame shutdown tail lost: ${clear_json}")
endif()
file(REMOVE "${report}")
file(REMOVE_RECURSE "${scratch}")
message(STATUS "${app_name}: profile JSON, parameters, warmup/tail, Unicode path, no overwrite, clear stdout passed.")
