if(NOT DEFINED PROGRAM)
    message(FATAL_ERROR "PROGRAM is required")
endif()
get_filename_component(bin "${PROGRAM}" DIRECTORY)
get_filename_component(name "${PROGRAM}" NAME_WE)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(scratch "${bin}/test-scratch/m3-${name}-${nonce}")
file(MAKE_DIRECTORY "${scratch}")
function(run expected)
    execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output
        ERROR_VARIABLE error TIMEOUT 25 WORKING_DIRECTORY "${scratch}")
    if(NOT "${code}" STREQUAL "${expected}")
        message(FATAL_ERROR "M3 CLI exit ${code}, expected ${expected}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
    set(last_error "${error}" PARENT_SCOPE)
endfunction()
foreach(mode IN ITEMS copy grayscale)
    set(report "${scratch}/报告-${mode}.json")
    set(capture "${scratch}/捕获-${mode}.png")
    run(0 --offscreen --postprocess "${mode}" --width 641 --height 359
        --camera-eye 0.25 0.125 -3 --camera-target 0.25 0.125 0 --fov 75
        --scale 0.75 --tint 1 0.8 0.6 0.5 --profile --warmup 2 --samples 3
        --gpu-validation --report "${report}" --capture "${capture}")
    if(NOT last_output MATCHES "window_created=0" OR NOT last_output MATCHES "vsync=off"
            OR last_output MATCHES "window client=" OR last_output MATCHES "presentations=[1-9]")
        message(FATAL_ERROR "Offscreen incorrectly claims window/presentation: ${last_output}")
    endif()
    file(READ "${report}" json)
    string(JSON complete GET "${json}" complete)
    string(JSON execution GET "${json}" mode)
    string(JSON vsync GET "${json}" vsync)
    string(JSON count GET "${json}" sample_count)
    string(JSON selected GET "${json}" postprocess)
    string(JSON post_type TYPE "${json}" gpu_post)
    if(NOT complete OR NOT execution STREQUAL "offscreen" OR vsync OR NOT count EQUAL 3
            OR NOT selected STREQUAL "${mode}" OR NOT post_type STREQUAL "OBJECT")
        message(FATAL_ERROR "Invalid offscreen profile metadata: ${json}")
    endif()
    foreach(index RANGE 0 2)
        string(JSON frame GET "${json}" samples ${index} frame_number)
        string(JSON presentation GET "${json}" samples ${index} presentation)
        string(JSON generation GET "${json}" samples ${index} post_generation)
        string(JSON post_ms GET "${json}" samples ${index} gpu_post_ms)
        math(EXPR expected "${index} + 3")
        if(NOT frame EQUAL expected OR NOT presentation EQUAL 0 OR NOT generation EQUAL 1
                OR post_ms LESS 0)
            message(FATAL_ERROR "Wrong offscreen sequence/post measurement: ${json}")
        endif()
    endforeach()
    file(READ "${capture}" signature OFFSET 0 LIMIT 8 HEX)
    if(NOT signature STREQUAL "89504e470d0a1a0a")
        message(FATAL_ERROR "Capture is not a PNG")
    endif()
    file(SHA256 "${capture}" original)
    run(1 --offscreen --capture "${capture}")
    file(SHA256 "${capture}" preserved)
    if(NOT preserved STREQUAL original OR last_output MATCHES "adapter=")
        message(FATAL_ERROR "Existing capture was changed or GPU started before rejection")
    endif()
    run(0 --windowed --postprocess "${mode}" --width 640 --height 360 --frames 3
        --gpu-validation --profile --warmup 0 --samples 3 --report "${scratch}/window-${mode}.json")
    file(READ "${scratch}/window-${mode}.json" window_json)
    string(JSON window_mode GET "${window_json}" mode)
    string(JSON window_vsync GET "${window_json}" vsync)
    string(JSON window_complete GET "${window_json}" complete)
    if(NOT window_mode STREQUAL "windowed" OR NOT window_vsync OR NOT window_complete)
        message(FATAL_ERROR "Windowed post path did not complete: ${window_json}")
    endif()
endforeach()
run(0 --offscreen --experiment clear --postprocess grayscale --width 17 --height 13
    --profile --warmup 0 --samples 1 --gpu-validation)
string(FIND "${last_output}" "{\n  \"schema\"" offset)
if(offset LESS 0)
    message(FATAL_ERROR "No clear offscreen stdout JSON: ${last_output}")
endif()
string(SUBSTRING "${last_output}" ${offset} -1 clear_json)
string(JSON clear_compiler TYPE "${clear_json}" compiler)
string(JSON scene_geometry TYPE "${clear_json}" geometry)
string(JSON clear_camera TYPE "${clear_json}" camera)
string(JSON count GET "${clear_json}" sample_count)
string(JSON present GET "${clear_json}" samples 0 presentation)
string(JSON frame GET "${clear_json}" samples 0 frame_number)
if(NOT clear_compiler STREQUAL "NULL" OR NOT scene_geometry STREQUAL "NULL"
        OR NOT clear_camera STREQUAL "NULL" OR NOT count EQUAL 1 OR NOT present EQUAL 0 OR NOT frame EQUAL 1)
    message(FATAL_ERROR "Clear offscreen tail or scene metadata incorrect: ${clear_json}")
endif()
run(0 --offscreen --experiment clear)
if(NOT last_output MATCHES "rendered_frames=1")
    message(FATAL_ERROR "Default offscreen must be finite one frame: ${last_output}")
endif()
run(1 --offscreen --postprocess copy --post-shader "${scratch}/missing.hlsl"
    --capture "${scratch}/failed.png")
if(EXISTS "${scratch}/failed.png" OR NOT last_error MATCHES "error:")
    message(FATAL_ERROR "Failed post initialization produced capture or no diagnostic")
endif()
run(1 --offscreen --capture "${scratch}/missing-parent/output.png")
if(last_output MATCHES "adapter=")
    message(FATAL_ERROR "Missing capture parent was not rejected before GPU")
endif()
run(1 --offscreen --profile --capture "${scratch}/alias.png" --report "${scratch}/./alias.png")
if(EXISTS "${scratch}/alias.png" OR last_output MATCHES "adapter=")
    message(FATAL_ERROR "Aliased report/capture path was not rejected before GPU")
endif()
file(REMOVE_RECURSE "${scratch}")
message(STATUS "${name}: M3 window/offscreen copy/grayscale, PNG, odd pitch, tail, input and output safety passed.")
