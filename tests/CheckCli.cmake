if(NOT DEFINED PROGRAM OR NOT DEFINED CASE OR NOT DEFINED EXPECTED_VERSION)
    message(FATAL_ERROR "PROGRAM, CASE and EXPECTED_VERSION are required.")
endif()

set(arguments)
set(expected_exit 0)
set(expected_output "Usage:")
get_filename_component(app_name "${PROGRAM}" NAME_WE)

if(CASE STREQUAL "default")
elseif(CASE STREQUAL "help")
    set(arguments --help)
elseif(CASE STREQUAL "version")
    set(arguments --version)
elseif(CASE STREQUAL "headless")
    set(arguments --headless --frames 3)
    set(expected_output "${app_name} mode=headless-logic ticks=3 simulated_seconds=0[.]050000")
elseif(CASE STREQUAL "default_frames")
    set(arguments --headless)
    set(expected_output "${app_name} mode=headless-logic ticks=1 simulated_seconds=0[.]016667")
else()
    set(expected_exit 2)
    if(CASE STREQUAL "unknown")
        set(arguments --unknown)
    elseif(CASE STREQUAL "missing_frames")
        set(arguments --headless --frames)
    elseif(CASE STREQUAL "zero_frames")
        set(arguments --headless --frames 0)
    elseif(CASE STREQUAL "negative_frames")
        set(arguments --headless --frames -1)
    elseif(CASE STREQUAL "overflow_frames")
        set(arguments --headless --frames 4294967296)
    elseif(CASE STREQUAL "trailing_frames")
        set(arguments --headless --frames 3x)
    elseif(CASE STREQUAL "missing_headless")
        set(arguments --frames 3)
    elseif(CASE STREQUAL "duplicate_headless")
        set(arguments --headless --headless)
    elseif(CASE STREQUAL "duplicate_frames")
        set(arguments --headless --frames 1 --frames 2)
    elseif(CASE STREQUAL "conflicting_help")
        set(arguments --help --headless)
    elseif(CASE STREQUAL "conflicting_modes")
        set(arguments --headless --windowed)
    elseif(CASE STREQUAL "duplicate_windowed")
        set(arguments --windowed --windowed)
    elseif(CASE STREQUAL "headless_debug")
        set(arguments --headless --debug-layer)
    elseif(CASE STREQUAL "headless_gbv")
        set(arguments --headless --gpu-validation)
    elseif(CASE STREQUAL "duplicate_debug")
        set(arguments --windowed --debug-layer --debug-layer)
    elseif(CASE STREQUAL "duplicate_gbv")
        set(arguments --windowed --gpu-validation --gpu-validation)
    elseif(CASE STREQUAL "windowed_zero")
        set(arguments --windowed --frames 0)
    elseif(CASE STREQUAL "windowed_unknown")
        set(arguments --windowed --unknown)
    elseif(CASE STREQUAL "headless_experiment")
        set(arguments --headless --experiment triangle)
    elseif(CASE STREQUAL "headless_shader")
        set(arguments --headless --shader test.hlsl)
    elseif(CASE STREQUAL "unknown_experiment")
        set(arguments --windowed --experiment unknown)
    elseif(CASE STREQUAL "missing_shader")
        set(arguments --windowed --shader)
    elseif(CASE STREQUAL "duplicate_shader")
        set(arguments --windowed --shader a.hlsl --shader b.hlsl)
    elseif(CASE STREQUAL "clear_shader")
        set(arguments --windowed --experiment clear --shader a.hlsl)
    else()
        message(FATAL_ERROR "Unknown test case: ${CASE}")
    endif()
endif()

execute_process(
    COMMAND "${PROGRAM}" ${arguments}
    RESULT_VARIABLE actual_exit
    OUTPUT_VARIABLE actual_output
    ERROR_VARIABLE actual_error
    TIMEOUT 10
)
if(NOT "${actual_exit}" STREQUAL "${expected_exit}")
    message(FATAL_ERROR "Expected exit ${expected_exit}, got ${actual_exit}.\n${actual_output}\n${actual_error}")
endif()
if(expected_exit EQUAL 0)
    if(NOT actual_error STREQUAL "")
        message(FATAL_ERROR "Unexpected stderr: ${actual_error}")
    endif()
    if(CASE STREQUAL "version")
        string(STRIP "${actual_output}" actual_output)
        if(NOT actual_output STREQUAL "${app_name} ${EXPECTED_VERSION}")
            message(FATAL_ERROR "Unexpected version: ${actual_output}")
        endif()
    elseif(NOT actual_output MATCHES "${expected_output}")
        message(FATAL_ERROR "Unexpected stdout: ${actual_output}")
    endif()
else()
    if(NOT actual_error MATCHES "^error:" OR NOT actual_output STREQUAL "")
        message(FATAL_ERROR "Invalid arguments must report an error on stderr only.\n${actual_output}\n${actual_error}")
    endif()
endif()
